---
interface Props {
  href: string;
  variant?: "primary" | "secondary";
  class?: string;
}

const { href, variant = "secondary", class: className = "" } = Astro.props;

const variantClasses = {
  primary: "text-white hover:text-white/80",
  secondary: "text-ed-primary-600 hover:text-ed-primary-700",
};

const classes = `${variantClasses[variant]} ${className}`;
---

<a
  href={href}
  class={`group inline-flex items-center font-semibold transition-colors duration-300 ${classes}`}
>
  <slot />

  <svg
    class="ml-2 h-5 w-5 transform transition-transform duration-300 ease-out group-hover:translate-x-1.5"
    fill="currentColor"
    viewBox="0 0 20 20"
    aria-hidden="true"
  >
    <path
      fill-rule="evenodd"
      d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414 1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
      clip-rule="evenodd"></path>
  </svg>
</a>

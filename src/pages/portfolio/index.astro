---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import Container from "../../components/Container.astro";
import PortfolioCard from "../../components/PortfolioCard.astro";

const projects = (await getCollection("portfolio")).sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
);
---

<Layout
  title="Portfolio | Ernadima Studio"
  description="Explore selected design, social media, branding, and web development projects by Ernadima Studio."
  canonical="https://ernadima.com/portfolio"
>
  <Navbar />
  <main>
    <section class="bg-ed-primary-800">
      <Container class="py-20 md:py-24">
        <div class="mx-auto max-w-3xl text-center">
          <span class="ed-caption font-medium text-ed-primary-300">
            Our Portfolio
          </span>
          <h1 class="ed-subheading mt-3 text-white">
            Selected work that <span class="text-ed-primary-300">speaks for itself.</span>
          </h1>
          <p class="ed-body mt-4 text-white/70">
            Explore selected projects across design, branding, social media, and digital experiences.
          </p>
        </div>

        {projects.length > 0 ? (
          <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-2">
            {projects.map((project) => (
              <PortfolioCard
                category={project.data.category}
                title={project.data.title}
                description={project.data.shortDescription}
                image={project.data.coverImage}
                href={`/portfolio/${project.id}`}
              />
            ))}
          </div>
        ) : (
          <p class="mt-12 text-center text-white/80">Portfolio projects will be added soon.</p>
        )}
      </Container>
    </section>
  </main>
  <Footer />
</Layout>

---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import Container from "../../components/Container.astro";
import Button from "../../components/Button.astro";

export async function getStaticPaths() {
  const projects = await getCollection("portfolio");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const data = project.data;
const canonical = `https://ernadima.com/portfolio/${project.id}`;
---

<Layout
  title={`${data.title} | Portfolio | Ernadima Studio`}
  description={data.shortDescription}
  canonical={canonical}
>
  <Navbar />
  <main>
    <section class="bg-gray-100">
      <Container class="py-12 md:py-16">
        <div class="mx-auto mt-8">
          <span
            class="ed-caption font-semibold uppercase tracking-widest text-ed-primary-700"
            >{data.category}</span
          >
          <h1 class="ed-heading mt-3 text-ed-neutral-950">{data.title}</h1>
          <p class="ed-body mt-5 max-w-3xl text-ed-neutral-900">
            {data.shortDescription}
          </p>
          <div
            class="relative mt-8 aspect-video overflow-hidden rounded-2xl bg-gray-200"
          >
            <div
              class="absolute inset-0 animate-pulse bg-gray-200 transition-opacity duration-500"
              data-detail-cover-skeleton
              aria-hidden="true"
            >
            </div>
            <img
              src={data.coverImage}
              alt={data.title}
              class="relative z-10 h-full w-full object-cover opacity-0 transition-opacity duration-500"
              data-detail-cover-image
              fetchpriority="high"
            />
          </div>
        </div>
      </Container>
    </section>

    <section class="bg-white">
      <Container class="py-16 md:py-20">
        <div
          class="grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,2fr)_minmax(220px,1fr)]"
        >
          <article class="min-w-0">
            <h2 class="ed-subheading text-ed-neutral-950">Project overview</h2>
            <div class="portfolio-content mt-6 max-w-none">
              <Content />
            </div>

            {
              data.gallery.length > 0 && (
                <section class="mt-12" aria-labelledby="gallery-heading">
                  <h2
                    id="gallery-heading"
                    class="ed-subheading text-ed-neutral-950"
                  >
                    Project gallery
                  </h2>
                  <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2">
                    {data.gallery.map((image, index) => (
                      <div class="relative aspect-video overflow-hidden rounded-xl bg-gray-200">
                        <div
                          class="absolute inset-0 animate-pulse bg-gray-200 transition-opacity duration-500"
                          data-gallery-skeleton
                          aria-hidden="true"
                        />
                        <img
                          src={image}
                          alt={`${data.title} gallery image ${index + 1}`}
                          loading="lazy"
                          decoding="async"
                          class="relative z-10 h-full w-full object-cover opacity-0 transition-opacity duration-500"
                          data-gallery-image
                        />
                      </div>
                    ))}
                  </div>
                </section>
              )
            }
          </article>

          <aside class="h-fit rounded-2xl bg-ed-primary-50 p-6">
            <h2 class="text-lg font-semibold text-ed-neutral-950">
              Project details
            </h2>
            {
              data.client && (
                <div class="mt-5">
                  <p class="ed-caption">Client</p>
                  <p class="mt-1 font-medium text-ed-neutral-950">
                    {data.client}
                  </p>
                </div>
              )
            }
            {
              data.year && (
                <div class="mt-5">
                  <p class="ed-caption">Year</p>
                  <p class="mt-1 font-medium text-ed-neutral-950">
                    {data.year}
                  </p>
                </div>
              )
            }
            <div class="mt-5">
              <p class="ed-caption">Services</p>
              <div class="mt-2 flex flex-wrap gap-2">
                {
                  data.services.map((service) => (
                    <span class="rounded-full bg-white px-3 py-1 text-sm text-ed-primary-800">
                      {service}
                    </span>
                  ))
                }
              </div>
            </div>
            <div class="mt-5">
              <p class="ed-caption">Tools</p>
              <div class="mt-2 flex flex-wrap gap-2">
                {
                  data.tools.map((tool) => (
                    <span class="rounded-full border border-ed-primary-200 px-3 py-1 text-sm text-ed-neutral-900">
                      {tool}
                    </span>
                  ))
                }
              </div>
            </div>
            {
              data.tags.length > 0 && (
                <div class="mt-5">
                  <p class="ed-caption">Tags</p>
                  <div class="mt-2 flex flex-wrap gap-2">
                    {data.tags.map((tag) => (
                      <span class="text-sm text-ed-neutral-900">#{tag}</span>
                    ))}
                  </div>
                </div>
              )
            }
            {
              data.externalUrl && (
                <div class="mt-7">
                  <Button href={data.externalUrl}>View live project</Button>
                </div>
              )
            }
          </aside>
        </div>

        <div
          class="mt-16 rounded-2xl bg-ed-primary-800 px-6 py-10 text-center md:px-10"
        >
          <h2 class="ed-subheading text-white">Have a project in mind?</h2>
          <p class="ed-body mx-auto mt-3 max-w-2xl text-white/75">
            Let's discuss how Ernadima Studio can help bring your ideas to life.
          </p>
          <div class="mt-6">
            <Button
              href="/contact"
              variant="secondary"
              class="border-white text-white hover:bg-white/10"
              >Contact us</Button
            >
          </div>
        </div>
      </Container>
    </section>
  </main>
  <Footer />
</Layout>

<script src="../../scripts/portfolio-detail-images.ts"></script>

---
import Button from "../components/Button.astro";
import LinkArrow from "../components/LinkArrow.astro";
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import FeaturedPortfolio from "../components/FeaturedPortfolio.astro";
import Testimonial from "../components/Testimonials.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Home | ED-Studio"
  description="Ernadima Studio membantu bisnis dan individu melalui jasa desain grafis, website modern, branding, dan solusi digital yang profesional dan terpercaya."
  canonical="https://ernadima.com"
>
  <Navbar />

  <!-- Start of Hero Section -->
  <section class="mt-16 bg-gray-50">
    <Container
      class="grid min-h-[calc(100vh-5rem)] grid-cols-1 items-center gap-12 py-16 sm:py-0 lg:grid-cols-12"
    >
      <!-- Content -->
      <div class="order-2 lg:order-1 lg:col-span-7">
        <!-- Badge -->
        <a
          href="/service"
          class="mb-7 inline-flex items-center rounded-full border border-gray-200 bg-white py-1 pl-1 pr-4 text-sm text-gray-700 transition hover:bg-gray-100"
        >
          <span
            class="rounded-full bg-ed-primary-600 px-4 py-1.5 text-xs font-medium text-white"
          >
            Available
          </span>

          <span class="ml-3 text-sm font-medium">
            Explore our digital services
          </span>

          <svg
            class="ml-2 h-5 w-5"
            fill="currentColor"
            viewBox="0 0 20 20"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
              clip-rule="evenodd"></path>
          </svg>
        </a>

        <!-- Heading -->
        <h1 class="ed-heading max-w-3xl tracking-tight">
          Digital Solutions
          <span class="text-ed-primary-600"> for Your Business </span>
        </h1>

        <!-- Description -->
        <p class="ed-body mt-6 max-w-2xl text-gray-600">
          We help businesses, organizations, and individuals build a stronger
          digital presence through branding, graphic design, websites, and
          digital solutions that are both beautiful and purposeful.
        </p>

        <!-- CTA -->
        <div class="mt-10 flex flex-wrap gap-4">
          <Button href="/service">
            View Our Services
            <span
              class="material-symbols-rounded ml-2 text-xl transition-transform duration-300 group-hover:translate-x-1"
              aria-hidden="true"
            >
              arrow_forward
            </span>
          </Button>

          <Button href="/contact" variant="secondary">
            Free Consultation
          </Button>
        </div>
      </div>
      <!-- Place Holder -->
      <div class="order-1 flex justify-center lg:order-2 lg:col-span-5">
        <div
          role="status"
          class="w-full max-w-md animate-pulse rounded-3xl border border-gray-200 bg-white p-6 shadow-lg"
        >
          <div class="mb-6 h-6 w-40 rounded bg-gray-200"></div>

          <div class="space-y-3">
            <div class="h-4 rounded bg-gray-200"></div>
            <div class="h-4 w-5/6 rounded bg-gray-200"></div>
            <div class="h-4 w-3/4 rounded bg-gray-200"></div>
          </div>

          <div class="my-8 h-56 rounded-2xl bg-gray-200"></div>

          <div class="flex gap-3">
            <div class="h-10 flex-1 rounded-lg bg-gray-200"></div>
            <div class="h-10 w-20 rounded-lg bg-gray-200"></div>
          </div>

          <span class="sr-only">Loading...</span>
        </div>
      </div>
    </Container>
  </section>
  <!-- End of Hero Section -->

  <!-- Start of Social Proof -->
  <section class="bg-ed-primary-50">
    <Container class="py-20">
      <div class="mx-auto max-w-3xl text-center">
        <span class="ed-caption font-medium text-gray-700">
          Trusted by Clients
        </span>

        <h2 class="ed-subheading mt-3">
          Trusted by <span class="text-ed-primary-600">
            Businesses and Organizations
          </span>
        </h2>

        <p class="ed-body mt-4 text-gray-600">
          We help businesses, educational institutions, organizations, and
          individuals create impactful designs and digital solutions that
          strengthen their brand and online presence.
        </p>
      </div>

      <!-- Statistics -->
      <div class="mt-16 grid grid-cols-2 gap-8 text-center lg:grid-cols-4">
        <div>
          <h3 class="text-4xl font-bold text-ed-primary-600">500+</h3>
          <p class="ed-body mt-2 text-gray-600">Completed Projects</p>
        </div>

        <div>
          <h3 class="text-4xl font-bold text-ed-primary-600">100+</h3>
          <p class="ed-body mt-2 text-gray-600">Happy Clients</p>
        </div>

        <div>
          <h3 class="text-4xl font-bold text-ed-primary-600">5+</h3>
          <p class="ed-body mt-2 text-gray-600">Years of Experience</p>
        </div>

        <div>
          <h3 class="text-4xl font-bold text-ed-primary-600">98%</h3>
          <p class="ed-body mt-2 text-gray-600">Client Satisfaction</p>
        </div>
      </div>

      <div class="my-16 h-px w-full bg-gray-200"></div>

      <!-- Client Logos -->
      <div class="flex flex-wrap items-center justify-center gap-10 opacity-60">
        {
          Array.from({ length: 5 }).map(() => (
            <div
              role="status"
              class="flex h-16 items-center justify-center rounded-lg bg-gray-200 animate-pulse"
            >
              <div class="h-24 w-48 rounded bg-gray-300" />
              <span class="sr-only">Loading...</span>
            </div>
          ))
        }
      </div>
    </Container>
  </section>
  <!-- ENd of Social Proof -->

  <!-- Start of Services Section -->
  <section class="bg-gray-50">
    <Container class="py-20">
      <div class="mx-auto max-w-3xl text-center">
        <span class="ed-caption font-medium text-gray-700"> What We Do </span>

        <h2 class="ed-subheading mt-3">
          Take the work
          <span class="text-ed-primary-600"> off your plate.</span>
        </h2>

        <p class="ed-body mt-4 text-gray-600">
          We handle the tasks that take your time away from what matters most.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
        <!-- Start of Administrative Support -->
        <article
          class="flex h-full flex-col rounded-2xl bg-ed-primary-600 p-8 text-white shadow-lg transition-all duration-300 hover:-translate-y-1 hover:bg-ed-primary-700 hover:shadow-xl"
        >
          <div class="text-sm font-semibold text-white/60">01</div>
          <div class="mt-10">
            <h3 class="text-2xl font-bold tracking-tight">
              Administrative Support
            </h3>
            <p class="mt-4 leading-7 text-white/80">
              Take repetitive administrative tasks off your plate so you can
              focus on running your business.
            </p>
          </div>
          <div class="mt-auto pt-8">
            <LinkArrow href="/service" variant="primary">
              Learn More
            </LinkArrow>
          </div>
        </article>
        <!-- End of Administrative Support -->

        <!-- Start of Lead Generation -->
        <article
          class="flex h-full flex-col rounded-2xl border border-ed-primary-200 bg-white p-8 text-gray-900 transition-all duration-300 hover:-translate-y-1 hover:border-ed-primary-400 hover:bg-ed-primary-50 hover:shadow-xl"
        >
          <div class="text-sm font-semibold text-ed-primary-600">02</div>

          <div class="mt-10">
            <h3 class="text-2xl font-bold tracking-tight">Lead Generation</h3>

            <p class="mt-4 leading-7 text-ed-neutral-900">
              Find, research, and organize potential leads so you can spend more
              time turning prospects into clients.
            </p>
          </div>

          <div class="mt-auto pt-8">
            <LinkArrow href="/service">Learn More</LinkArrow>
          </div>
        </article>
        <!-- End of Lead Generation -->

        <!-- Start of Social Media Management -->
        <article
          class="flex h-full flex-col rounded-2xl border border-ed-primary-200 bg-white p-8 text-gray-900 transition-all duration-300 hover:-translate-y-1 hover:border-ed-primary-400 hover:bg-ed-primary-50 hover:shadow-xl"
        >
          <div class="text-sm font-semibold text-ed-primary-600">03</div>

          <div class="mt-10">
            <h3 class="text-2xl font-bold tracking-tight">
              Social Media Management
            </h3>

            <p class="mt-4 leading-7 text-ed-neutral-900">
              Keep your social presence consistent with content scheduling,
              publishing, and day-to-day management.
            </p>
          </div>

          <div class="mt-auto pt-8">
            <LinkArrow href="/service">Learn More</LinkArrow>
          </div>
        </article>
        <!-- End of Social Media Management -->
      </div>

      <div class="mt-14 text-center">
        <p class="ed-body text-gray-600">
          If you need something else, we also offer <a
            href="/service"
            class="font-semibold text-ed-primary-600 transition hover:text-ed-primary-700"
          >
            supporting digital services.
          </a>
        </p>
      </div>
    </Container>
  </section>
  <!-- End of Service Section -->

  <!-- Start of Featured Portfolio -->
  <section class="bg-ed-primary-800">
    <Container class="py-20">
      <div class="mx-auto max-w-3xl text-center">
        <span class="ed-caption font-medium text-ed-primary-300">
          Featured Portfolio
        </span>

        <h2 class="ed-subheading mt-3 text-white">
          Selected work that
          <span class="text-ed-primary-300"> speaks for itself.</span>
        </h2>

        <p class="ed-body mt-4 text-white/70">
          A selection of projects we've created to help businesses,
          organizations, and individuals communicate their ideas through
          thoughtful design and digital solutions.
        </p>
      </div>

      <FeaturedPortfolio />
    </Container>
  </section>
  <!-- End of Featured Portfolio -->

  <!-- Start of About Section -->
  <section class="bg-gray-50">
    <Container class="py-20">
      <!-- About Preview -->
      <div
        class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16"
      >
        <!-- Image -->
        <div
          class="relative aspect-4/3 overflow-hidden rounded-3xl bg-ed-primary-100"
        >
          <!-- Image Skeleton -->
          <div
            class="absolute inset-0 animate-pulse bg-ed-primary-100 transition-opacity duration-500"
            data-about-skeleton
            aria-hidden="true"
          >
          </div>

          <!-- About Image -->
          <img
            src="/images/about-preview.jpg"
            alt="Ernadima Studio"
            loading="lazy"
            decoding="async"
            class="relative z-0 h-full w-full object-cover opacity-0 transition-opacity duration-500"
            data-about-image
          />
        </div>

        <!-- Content -->
        <div>
          <span class="ed-caption font-medium text-gray-700">
            About Ernadima Studio
          </span>

          <h2 class="ed-subheading mt-3">
            Digital solutions designed to
            <span class="text-ed-primary-600"> move your ideas </span>
            forward.
          </h2>

          <p class="ed-body mt-4 text-gray-600">
            Ernadima Studio helps businesses, organizations, and personal brands
            turn their ideas into clear and effective digital experiences
            through thoughtful design and practical digital solutions.
          </p>

          <div class="mt-8">
            <LinkArrow href="/about"> Learn More About Us </LinkArrow>
          </div>
        </div>
      </div>

      <!-- Workflow -->
      <div class="mt-24 lg:mt-32">
        <!-- Workflow Heading -->
        <div class="mx-auto max-w-2xl text-center">
          <span class="ed-caption font-medium text-gray-700">
            Our Workflow
          </span>

          <h2 class="ed-subheading mt-3">
            From
            <span class="text-ed-primary-600"> your idea</span>
            , to
            <span class="text-ed-primary-600"> our deliver.</span>
          </h2>

          <p class="ed-body mt-4 text-gray-600">
            We keep the process clear and straightforward so you always know
            what happens next.
          </p>
        </div>

        <!-- Workflow Cards -->
        <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-4">
          <!-- Step 01 -->
          <article
            class="group rounded-2xl bg-white p-6 text-center shadow-sm transition-all duration-300 hover:-translate-y-1 hover:bg-ed-primary-600 hover:shadow-lg"
          >
            <div
              class="mx-auto flex h-14 w-14 items-center justify-center rounded-xl bg-ed-primary-50 text-ed-primary-600 transition-colors duration-300 group-hover:bg-white/15 group-hover:text-white"
            >
              <span class="material-symbols-rounded text-3xl"> chat </span>
            </div>

            <span
              class="mt-5 block text-xs font-semibold uppercase tracking-widest text-ed-primary-600 transition-colors duration-300 group-hover:text-white/70"
            >
              Step 01
            </span>

            <h3
              class="mt-2 text-xl font-semibold text-ed-neutral-950 transition-colors duration-300 group-hover:text-white"
            >
              Tell Us What You Need
            </h3>

            <p
              class="mt-3 text-sm leading-relaxed text-ed-neutral-900 transition-colors duration-300 group-hover:text-white/75"
            >
              Share your goals, ideas, and what you need help with.
            </p>
          </article>

          <!-- Step 02 -->
          <article
            class="group rounded-2xl bg-white p-6 text-center shadow-sm transition-all duration-300 hover:-translate-y-1 hover:bg-ed-primary-600 hover:shadow-lg"
          >
            <div
              class="mx-auto flex h-14 w-14 items-center justify-center rounded-xl bg-ed-primary-50 text-ed-primary-600 transition-colors duration-300 group-hover:bg-white/15 group-hover:text-white"
            >
              <span class="material-symbols-rounded text-3xl">
                event_note
              </span>
            </div>

            <span
              class="mt-5 block text-xs font-semibold uppercase tracking-widest text-ed-primary-600 transition-colors duration-300 group-hover:text-white/70"
            >
              Step 02
            </span>

            <h3
              class="mt-2 text-xl font-semibold text-ed-neutral-950 transition-colors duration-300 group-hover:text-white"
            >
              We Plan the Work
            </h3>

            <p
              class="mt-3 text-sm leading-relaxed text-ed-neutral-900 transition-colors duration-300 group-hover:text-white/75"
            >
              We define the scope, direction, and steps needed for the project.
            </p>
          </article>

          <!-- Step 03 -->
          <article
            class="group rounded-2xl bg-white p-6 text-center shadow-sm transition-all duration-300 hover:-translate-y-1 hover:bg-ed-primary-600 hover:shadow-lg"
          >
            <div
              class="mx-auto flex h-14 w-14 items-center justify-center rounded-xl bg-ed-primary-50 text-ed-primary-600 transition-colors duration-300 group-hover:bg-white/15 group-hover:text-white"
            >
              <span class="material-symbols-rounded text-3xl"> task_alt </span>
            </div>

            <span
              class="mt-5 block text-xs font-semibold uppercase tracking-widest text-ed-primary-600 transition-colors duration-300 group-hover:text-white/70"
            >
              Step 03
            </span>

            <h3
              class="mt-2 text-xl font-semibold text-ed-neutral-950 transition-colors duration-300 group-hover:text-white"
            >
              We Get It Done
            </h3>

            <p
              class="mt-3 text-sm leading-relaxed text-ed-neutral-900 transition-colors duration-300 group-hover:text-white/75"
            >
              We work on the project while keeping communication clear and
              focused.
            </p>
          </article>

          <!-- Step 04 -->
          <article
            class="group rounded-2xl bg-white p-6 text-center shadow-sm transition-all duration-300 hover:-translate-y-1 hover:bg-ed-primary-600 hover:shadow-lg"
          >
            <div
              class="mx-auto flex h-14 w-14 items-center justify-center rounded-xl bg-ed-primary-50 text-ed-primary-600 transition-colors duration-300 group-hover:bg-white/15 group-hover:text-white"
            >
              <span class="material-symbols-rounded text-3xl"> verified </span>
            </div>

            <span
              class="mt-5 block text-xs font-semibold uppercase tracking-widest text-ed-primary-600 transition-colors duration-300 group-hover:text-white/70"
            >
              Step 04
            </span>

            <h3
              class="mt-2 text-xl font-semibold text-ed-neutral-950 transition-colors duration-300 group-hover:text-white"
            >
              Review & Deliver
            </h3>

            <p
              class="mt-3 text-sm leading-relaxed text-ed-neutral-900 transition-colors duration-300 group-hover:text-white/75"
            >
              We review the result, make the necessary adjustments, and deliver
              the final work.
            </p>
          </article>
        </div>
      </div>
    </Container>
  </section>
  <!-- End of About Section -->

  <!-- Start of Testimonials Section -->
  <section class="overflow-hidden bg-ed-primary-50 py-20 md:py-24">
    <Container class="pb-10">
      <div class="mx-auto max-w-2xl text-center">
        <span class="ed-caption font-medium text-gray-700"> Testimonials </span>

        <h2 class="ed-subheading mt-3">
          What
          <span class="text-ed-primary-600"> Our Clients </span>
          Say
        </h2>

        <p class="ed-body mt-4 text-gray-600">
          We help businesses stay organized, save time, and get more done.
        </p>
      </div>
    </Container>

    <Testimonial />
  </section>
  <!-- End of Testimonials Section -->

  <!-- Start of CTA Section  -->
  <section class="bg-ed-primary-600">
    <Container class="py-20">
      <div class="mx-auto max-w-4xl text-center">
        <span class="ed-caption font-medium text-ed-primary-300">
          Make Room for What Matters
        </span>

        <h2 class="ed-heading mt-3 text-white">
          You have more
          <span class="text-ed-primary-300"> important </span>
          things to do.
        </h2>

        <p class="ed-body mt-4 text-white/70">
          Let us handle the repetitive work, the daily admin, and the tasks that
          keep piling up — so you can spend your time where it actually matters.
        </p>

        <div class="mt-8">
          <Button
            href="/contact"
            variant="secondary"
            class="border-white bg-white text-ed-primary-600 hover:bg-ed-primary-50 hover:text-ed-primary-700"
          >
            Let's Discuss
          </Button>
        </div>
      </div>
    </Container>
  </section>
  <!-- End of CTA Section -->
  <Footer />
</Layout>
